# ============================================================
# Riyad Sarkar — environment variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# --- Supabase ---
# Project URL + Publishable key from Supabase dashboard → Project Settings → API
# Keep the existing production project. Do not replace these with new credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Optional alias if the deployment still uses the legacy anon key name
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin email (receives appointment/ticket notifications, first admin)
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Server-side email (required for the public contact form). ---
# Create an API key at https://resend.com (server-only, never exposed)
# Contact success is confirmed only after Resend (or EmailJS fallback) reports success.
# Names must match exactly. Add them in Vercel → Settings → Environment Variables
# for Production, then Redeploy. Do not put the key in NEXT_PUBLIC_*.
RESEND_API_KEY=
# Must be a Resend-verified domain sender, e.g. Riyad Sarkar <hello@yourdomain.com>
# Do not use Gmail/Outlook/Yahoo or example.com — Resend will reject those.
# onboarding@resend.dev only delivers to the email that owns the Resend API key.
RESEND_FROM_EMAIL=Riyad Sarkar <onboarding@resend.dev>
# Optional. Required in Resend test mode: the email of the Resend account owner.
# If unset, messages go to NEXT_PUBLIC_ADMIN_EMAIL / NEXT_PUBLIC_PROFILE_EMAIL.
# RESEND_TO_EMAIL=you@your-resend-account.email

# --- Contact form EmailJS fallback (optional) ---
# Used only when RESEND_API_KEY is not set. Public key is safe to expose;
# never put private EmailJS keys here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# --- Availability (public badge). Use `available` or `unavailable`. ---
NEXT_PUBLIC_AVAILABILITY_STATUS=available

# --- Personal profile ---
NEXT_PUBLIC_PROFILE_EMAIL=riyadsarkar1243@gmail.com
NEXT_PUBLIC_PROFILE_WHATSAPP=+8801577174050
NEXT_PUBLIC_PROFILE_PHONE_DISPLAY=+880 1577-174050

# --- Social links ---
NEXT_PUBLIC_PROFILE_GITHUB=https://github.com/riyadsarkar07
NEXT_PUBLIC_PROFILE_LINKEDIN=https://linkedin.com/in/riyad-sarkar-6694a2180
NEXT_PUBLIC_PROFILE_FACEBOOK=https://facebook.com/RiyadSarkar007
NEXT_PUBLIC_PROFILE_INSTAGRAM=https://instagram.com/riyad__sharker
NEXT_PUBLIC_PROFILE_TELEGRAM=https://t.me/Riyads11

# --- CV download ---
NEXT_PUBLIC_CV_URL=/cv/Riyad-Sarkar-CV.pdf
