# ============================================================
# Riyad Sarkar — environment variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# --- Supabase ---
# Project URL + Publishable key from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Admin email (receives appointment/ticket notifications, first admin)
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com

# --- Server-side email (optional). Real emails only send when set. ---
# Create an API key at https://resend.com (server-only, never exposed)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Riyad Sarkar <notifications@example.com>

# --- Contact form (EmailJS) ---
# Create a free account at https://www.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# --- Personal profile ---
NEXT_PUBLIC_PROFILE_EMAIL=riyadsarkar1243@gmail.com
NEXT_PUBLIC_PROFILE_WHATSAPP=+8801577174050
NEXT_PUBLIC_PROFILE_PHONE_DISPLAY=+880 1577-174050

# --- Social links ---
NEXT_PUBLIC_PROFILE_GITHUB=https://github.com/riyadsarkar07
